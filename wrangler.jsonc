{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "eto",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding — the service name must match the worker name above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "eto"
		}
	],
	"images": {
		// Enables next/image optimization via Cloudflare Images.
		"binding": "IMAGES"
	}
}
